<!doctype html>
<html lang="{{lang}}"{{raw htmlattrs}}><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#FFF8EC"><link rel="icon" href="/favicon.svg" type="image/svg+xml"><link rel="icon" href="/icon-32.png" sizes="32x32"><link rel="apple-touch-icon" href="/icon-180.png"><link rel="stylesheet" href="/style.css">{{raw fontcss}}
<title>{{t privacy.title}}</title>
<meta name="description" content="{{a privacy.description}}">
<link rel="canonical" href="{{raw canonical}}">{{raw alternates}}{{raw langscript}}
</head><body>
<main class="page">{{raw langmenu}}
  <article class="sheet prose">
    <p><a class="back" href="{{u /}}">{{t privacy.back}}</a></p>
    <h1 style="font-size:46px">{{t privacy.h1}}</h1>
    <p class="small">{{t privacy.updated}}</p>
    <p>{{t privacy.short}}</p>

    <h2>{{t privacy.collect.title}}</h2>
    <ul>
      <li>{{t privacy.collect.guest}}</li>
      <li>{{t privacy.collect.account}}
        <ul>
          <li>{{t privacy.collect.email}}</li>
          <li>{{t privacy.collect.hash}}</li>
          <li>{{t privacy.collect.save}}</li>
          <li>{{t privacy.collect.dates}}</li>
        </ul>
      </li>
    </ul>
    <p>{{t privacy.collect.nothing_else}}</p>

    <h2>{{t privacy.dont.title}}</h2>
    <ul>
      <li>{{t privacy.dont.ads}}</li>
      <li>{{t privacy.dont.tracking}}</li>
      <li>{{t privacy.dont.share}}</li>
      <li>{{t privacy.dont.email}}</li>
    </ul>

    <h2>{{t privacy.cards.title}}</h2>
    <p>{{t privacy.cards.lead}}</p>
    <ul>
      <li>{{t privacy.cards.see}}</li>
      <li>{{t privacy.cards.never}}</li>
      <li>{{t privacy.cards.paws}}</li>
      <li>{{t privacy.cards.off}}</li>
    </ul>

    <h2>{{t privacy.where.title}}</h2>
    <p>{{t privacy.where.text}}</p>

    <h2>{{t privacy.children.title}}</h2>
    <p>{{t privacy.children.text}}</p>

    <h2>{{t privacy.choices.title}}</h2>
    <ul>
      <li>{{t privacy.choices.guest}}</li>
      <li>{{t privacy.choices.export}}</li>
      <li>{{t privacy.delete}}</li>
      <li>{{t privacy.choices.ask}}</li>
    </ul>

    <h2>{{t privacy.changes.title}}</h2>
    <p>{{t privacy.changes.text}}</p>

    <h2>{{t privacy.contact.title}}</h2>
    <p><a class="mail" href="mailto:contact@doodledoggo.app">contact@doodledoggo.app</a></p>
  </article>
  <footer class="foot"><a href="{{u /}}">{{t footer.home}}</a> · <a href="https://www.instagram.com/doodledoggo.app/" rel="noopener">{{t footer.instagram}}</a> · <a href="mailto:contact@doodledoggo.app" id="contact" class="contact">{{t footer.contact}}</a> · <a href="https://an9ou.itch.io/doodle-doggo">{{t footer.play_itch}}</a></footer>
</main>
</body></html>
