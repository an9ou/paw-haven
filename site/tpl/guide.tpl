<!doctype html>
<html lang="{{lang}}"{{raw htmlattrs}}><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#FFF8EC"><link rel="icon" href="/favicon.svg" type="image/svg+xml"><link rel="icon" href="/icon-32.png" sizes="32x32"><link rel="apple-touch-icon" href="/icon-180.png"><link rel="manifest" href="/site.webmanifest"><link rel="stylesheet" href="/style.css">{{raw fontcss}}
<title>{{t guide.title}}</title>
<meta name="description" content="{{a guide.description}}">
<link rel="canonical" href="{{raw canonical}}">{{raw alternates}}
<meta property="og:type" content="website"><meta property="og:site_name" content="Doodle Doggo"><meta property="og:url" content="{{raw canonical}}">{{raw oglocale}}
<meta property="og:title" content="{{a guide.og_title}}"><meta property="og:description" content="{{a guide.og_description}}">
<meta property="og:image" content="https://doodledoggo.app/logo-1200x630.png"><meta property="og:image:width" content="1200"><meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">{{raw langscript}}
</head><body>
<div class="deco" id="deco" aria-hidden="true"></div>
<main class="page">
  <div class="sheet guidesheet">{{raw header}}
    <article class="guide" id="guide">
      <h1>{{t guide.h1}}</h1>
      <p class="lead">{{t guide.lead}}</p>

      <h2>{{t guide.steps.title}}</h2>
      <ol class="gsteps">
        <li class="gstep"><img src="/img/art/dogs/corgi-happy.svg" alt="" width="240" height="200" loading="lazy"><div><h3>{{t guide.step1.t}}</h3><p>{{t guide.step1.p}}</p></div></li>
        <li class="gstep"><img src="/img/art/dogs/pug-sit.svg" alt="" width="240" height="200" loading="lazy"><div><h3>{{t guide.step2.t}}</h3><p>{{t guide.step2.p}}</p></div></li>
        <li class="gstep"><img src="/img/art/dogs/beagle-walk.svg" alt="" width="240" height="200" loading="lazy"><div><h3>{{t guide.step3.t}}</h3><p>{{t guide.step3.p}}</p></div></li>
        <li class="gstep"><img src="/img/art/dogs/golden-happy.svg" alt="" width="240" height="200" loading="lazy"><div><h3>{{t guide.step4.t}}</h3><p>{{t guide.step4.p}}</p></div></li>
        <li class="gstep"><img src="/img/art/dogs/shiba-sniff.svg" alt="" width="240" height="200" loading="lazy"><div><h3>{{t guide.step5.t}}</h3><p>{{t guide.step5.p}}</p></div></li>
      </ol>

      <section class="gbox gunlock">
        <h2>{{t guide.unlock.title}}</h2>
        <ul><li>{{t guide.unlock.b2}}</li><li>{{t guide.unlock.b3}}</li><li>{{t guide.unlock.more}}</li></ul>
      </section>

      <h2>{{t guide.tips.title}}</h2>
      <ul class="gtips">
        <li>{{t guide.tip1}}</li><li>{{t guide.tip2}}</li><li>{{t guide.tip3}}</li>
        <li>{{t guide.tip4}}</li><li>{{t guide.tip5}}</li><li>{{t guide.tip6}}</li>
      </ul>

      <section class="gbox gpups">
        <img src="/img/art/dogs/samoyed-pup.svg" alt="" width="240" height="200" loading="lazy">
        <div><h2>{{t guide.pups.title}}</h2><p>{{t guide.pups.p1}}</p><p>{{t guide.pups.p2}}</p></div>
      </section>

      <h2>{{t guide.faq.title}}</h2>
      <div class="gfaq">
        <details open><summary>{{t guide.faq.q1}}</summary><p>{{t guide.faq.a1}}</p></details>
        <details><summary>{{t guide.faq.q2}}</summary><p>{{t guide.faq.a2}}</p></details>
        <details><summary>{{t guide.faq.q3}}</summary><p>{{t guide.faq.a3}}</p></details>
        <details><summary>{{t guide.faq.q4}}</summary><p>{{t guide.faq.a4}}</p></details>
      </div>

      <div class="cta gcta"><p>{{t guide.cta}}</p><a class="chip" href="{{u /}}#game">{{t guide.cta_btn}} <span aria-hidden="true">→</span></a></div>
    </article>
  </div>
  <footer class="foot">
    <a href="https://www.instagram.com/doodledoggo.app/" id="insta" rel="noopener">{{t footer.instagram}}</a> · <a href="mailto:contact@doodledoggo.app" id="contact" class="contact">{{t footer.contact}}</a> · <a href="{{u /privacy}}">{{t footer.privacy}}</a> ·
    <a href="{{u /}}">{{t footer.home}}</a> · <a href="{{u /dogs}}">{{t footer.dogs}}</a> · <a href="{{u /map}}">{{t footer.map}}</a> · <a href="{{u /about}}">{{t footer.about}}</a> ·
    <a href="https://an9ou.itch.io/doodle-doggo">{{t footer.itch}}</a> · <a href="https://ko-fi.com/doodledoggoapp" id="kofilink" rel="noopener">{{t footer.kofi}}</a>
    <div class="small">{{t footer.credit}}</div>
  </footer>
</main>
<div class="petals" id="petals" aria-hidden="true"></div>
<script src="/js/site.js" defer></script>
</body></html>
