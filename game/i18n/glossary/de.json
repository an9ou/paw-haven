  "bans": [
    {
      "re": "(?<!\\p{L})(?:verkauf(?:en|e|st|t|te|test|ten|tet)?|verkäuflich\\p{L}*|zu\\s+verkaufen)(?!\\p{L})[^.!?¡¿…]*(?<!\\p{L})(?<!für\\s)(?<!für\\s(?:deinen|deine|dein|den|die|das|alle|kleine|große|einen|eine)\\s)(?:Hund(?:e|en|es)?|Hündchen|Hündin(?:nen)?|Welpen?|Welpchen)(?!\\p{L})|(?<!\\p{L})(?<!für\\s)(?<!für\\s(?:deinen|deine|dein|den|die|das|alle|kleine|große|einen|eine)\\s)(?:Hund(?:e|en|es)?|Hündchen|Hündin(?:nen)?|Welpen?|Welpchen)(?!\\p{L})[^.!?¡¿…]*(?<!\\p{L})(?:verkauf(?:en|e|st|t|te|test|ten|tet)?|verkäuflich\\p{L}*|zu\\s+verkaufen)(?!\\p{L})",
      "flags": "iu",
      "why": "never \"sell\" (verkaufen) for dogs or puppies; shops selling items for dogs (\"für Hunde\", \"Hundefutter\") are fine"
    },
    {
      "re": "z[üu]cht",
      "flags": "iu",
      "why": "\"breed\": züchten / Zucht / Züchter / Hundezucht / Aufzucht (no word in the game contains it)"
    },
    {
      "re": "(?<!\\p{L})(?:Deck(?:rüde|rüden|hengst|akt|taxe)\\p{L}*|decken\\s+lassen|sich\\s+paaren|paaren\\s+sich|(?:Ver)?paarung(?:en)?|verpaar\\p{L}*|Hundepaarung\\p{L}*|Vermehrer\\p{L}*|vermehren)(?!\\p{L})",
      "flags": "iu",
      "why": "\"stud\" / \"breed\": Deckrüde / decken lassen / Paarung / verpaaren / vermehren"
    },
    {
      "re": "(?<!\\p{L})(?:Wurfpreis\\p{L}*|Welpenpreis\\p{L}*|Preis\\s+(?:pro|je|für\\s+(?:einen|den|die|das|jeden))\\s+(?:Welpen?|Hund|Wurf))(?!\\p{L})",
      "flags": "iu",
      "why": "\"litter price\": Wurfpreis / Welpenpreis"
    },
    {
      "re": "(?:hergestellt\\s+in\\s+Japan|gefertigt\\s+in\\s+Japan|in\\s+Japan\\s+(?:hergestellt|gemacht|gefertigt|produziert)|Japan-made|made\\s+in\\s+japan)",
      "flags": "iu",
      "why": "never \"made in Japan\" (hergestellt in Japan); use \"im japanischen Stil\""
    },
    {
      "re": "nintendo|pok[eé]mon|animal\\s+crossing",
      "flags": "iu",
      "why": "franchise names (Nintendo, Pokémon, Animal Crossing)"
    },
    {
      "re": "(?<!\\p{L})(?:breed(?:ing|ers?)|bred|studs?|litter\\s+price)(?!\\p{L})",
      "flags": "iu",
      "why": "English loanwords for the banned words (breeding, breeder, bred, stud, litter price); the noun \"breed\" is fine"
    }
  ],
