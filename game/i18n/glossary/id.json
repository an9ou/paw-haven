  "bans": [
    {
      "re": "(?<!\\p{L})(?:jual|menjual|dijual|jualan|terjual|penjualan|jualkan|menjualnya|dijualnya|kujual|kaujual)(?!\\p{L})[^.!?¡¿…]*(?<!\\p{L})(?<!untuk\\s)(?<!buat\\s)(?<!(?:makanan|mainan|baju|camilan|kasur|rumah|kalung|pakaian|topi|sabun|sampo|tempat|sikat|tali|mangkuk|kandang)\\s)(?:anjing\\p{L}*|puppy|puppies)(?!\\p{L})|(?<!\\p{L})(?<!untuk\\s)(?<!buat\\s)(?<!(?:makanan|mainan|baju|camilan|kasur|rumah|kalung|pakaian|topi|sabun|sampo|tempat|sikat|tali|mangkuk|kandang)\\s)(?:anjing\\p{L}*|puppy|puppies)(?!\\p{L})[^.!?¡¿…]*(?<!\\p{L})(?:jual|menjual|dijual|jualan|terjual|penjualan|jualkan|menjualnya|dijualnya|kujual|kaujual)(?!\\p{L})",
      "flags": "iu",
      "why": "never \"sell\" (jual, menjual, dijual) for dogs or puppies; shops selling things for dogs (\"untuk anjing\", \"makanan anjing\") are fine"
    },
    {
      "re": "(?<!\\p{L})(?:mengawin\\p{L}*|(?:di|per|ber|ter)?kawin\\p{L}*|membiakkan|dibiakkan|pembiak(?:an)?|berkembang\\s+biak|(?:be|di|pe)?ternak\\p{L}*|peternakan)(?!\\p{L})",
      "flags": "iu",
      "why": "\"breed\" as a verb: mengawinkan / kawin / membiakkan / ternak"
    },
    {
      "re": "(?<!\\p{L})(?:pejantan\\p{L}*|pemacek|indukan)(?!\\p{L})",
      "flags": "iu",
      "why": "\"stud\": pejantan / pemacek / indukan"
    },
    {
      "re": "(?<!\\p{L})harga\\s+(?:per\\s+ekor|seekor|anakan|anak\\s+anjing\\p{L}*|per\\s+anak|satu\\s+anak|(?:anjing\\p{L}*|puppy|puppies))(?!\\p{L})",
      "flags": "iu",
      "why": "\"litter price\": harga anak anjing / harga per ekor"
    },
    {
      "re": "(?:buatan\\s+jepang|bikinan\\s+jepang|dibuat\\s+di\\s+jepang|(?:di)?produksi\\s+(?:di\\s+)?jepang|made\\s+in\\s+japan)(?!\\p{L})",
      "flags": "iu",
      "why": "never \"made in Japan\" (buatan Jepang, dibuat di Jepang); use \"gaya Jepang\""
    },
    {
      "re": "nintendo|pok[eé]mon|animal\\s+crossing",
      "flags": "iu",
      "why": "franchise names (Nintendo, Pokémon, Animal Crossing)"
    },
    {
      "re": "(?<!\\p{L})(?:breed(?:ing|ers?)|bred|studs?|litter\\s+price)(?!\\p{L})",
      "flags": "iu",
      "why": "English loanwords for the banned words (breeding, breeder, bred, stud, litter price); the noun \"breed\" is fine"
    }
