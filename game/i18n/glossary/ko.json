  "bans": [
    {
      "re": "번식|교배|브리딩|브리더|짝짓기",
      "flags": "u",
      "why": "\"breed\" as a verb (견종 = breed, the noun, is fine)"
    },
    {
      "re": "(?<![토순])종견|씨수캐|종모견|씨받이",
      "flags": "u",
      "why": "stud"
    },
    {
      "re": "분양|책임비|(?:강아지|새끼|반려견)[^.!?\\n]{0,4}(?:가격|값)",
      "flags": "u",
      "why": "litter price; 분양 is the pet-trade word, say 입양 보내기"
    },
    {
      "re": "(?:아기 ?강아지|강아지|반려견|댕댕이|멍멍이|(?<![0-9가-힣])개(?=[를을은는이가도들]|\\s|$))(?:들)?(?:을|를|은|는|이|가|도)? ?(?:[0-9]+ ?마리(?:를|을)? ?)?(?:팔|판매|판다|팝니다|사고|사요|산다|구매|구입)|(?:팔린|파는|팔|판매(?:하는| ?중인|된|할)?) ?(?:[0-9]+ ?마리 ?)?(?:아기 ?강아지|강아지|반려견|댕댕이|멍멍이|(?<![0-9가-힣])개(?=[를을은는이가도들]|\\s|$))(?! ?(?:옷|용품|간식|사료|장난감|침대|집|카드|스웨터|목걸이))",
      "flags": "u",
      "why": "selling (or buying) dogs; shops selling items is fine"
    },
    {
      "re": "닌텐도|닌텐독스|포켓몬|포켓 ?몬스터|동물의 ?숲|동숲",
      "flags": "u",
      "why": "franchise name"
    },
    {
      "re": "일본산|일본제|일본 ?제조|메이드 ?인 ?재팬|일본에서 만(?:든|들어|들었)|일본 게임",
      "flags": "u",
      "why": "\"made in Japan\"; say 일본풍 (Japan-style)"
    },
    {
      "re": "nintendo|pok[eé]mon|animal crossing",
      "flags": "iu",
      "why": "franchise name (Latin spelling)"
    },
    {
      "re": "made in japan|japanese-made",
      "flags": "iu",
      "why": "\"made in Japan\" (Latin spelling); say Japan-style"
    }
