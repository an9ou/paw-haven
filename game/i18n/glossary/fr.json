      "flags": "iu",
      "why": "no \"vente de chiens / chiots\""
    },
    {
      "re": "(?<!\\p{L})(?:élevages?|éleveur(?:s)?|éleveuse(?:s)?|accoupl(?:er|e|es|ent|ons|ez|é|ée|és|ées|ement|ements)|saillies?|reproduct(?:eur|eurs|rice|rices)|étalons?|faire\\s+reproduire|mâle\\s+reproducteur)(?!\\p{L})",
      "flags": "iu",
      "why": "\"breed\" / \"stud\": élevage / éleveur / accouplement / saillie / étalon / reproducteur"
    },
    {
      "re": "(?<!\\p{L})(?:él[eè]v(?:er|e|es|ent|ons|ez|é|ée|és|ées|ait|aient|ant)|fai(?:re|s|t|tes|sons)\\s+naître)\\s+(?:(?:des|les|ses|tes|mes|nos|vos|leurs|deux|un|une|ton|ta|son|sa|mon|ma|le|la|plein\\s+de)\\s+)?(?:chien(?:s|ne|nes)?|chiots?|toutous?|portées?)(?!\\p{L})",
      "flags": "iu",
      "why": "\"breed\" as a verb: élever des chiens (use \"s'occuper de\")"
    },
    {
      "re": "(?<!\\p{L})(?:crois(?:er|e|es|ent|ons|ez|é|és))\\s+(?:ton|ta|tes|son|sa|ses|mon|ma|mes|deux)\\s+(?:chien(?:s|ne|nes)?|chiots?|toutous?|portées?)(?!\\p{L})|(?<!\\p{L})(?:croisements?|reproduction)\\s+(?:de|des|entre)\\s+(?:deux\\s+)?(?:chien(?:s|ne|nes)?|chiots?|toutous?|portées?)(?!\\p{L})",
      "flags": "iu",
      "why": "\"breed\" as a verb: croiser deux chiens (\"croiser des chiens au parc\" = to meet them, fine)"
